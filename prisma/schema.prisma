generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A physical handheld device in the warehouse fleet: a barcode scanner or a
// two-way radio. Numbers are unique PER TYPE, so "Scanner #3" and "Radio #3"
// can both exist.
model Device {
  id       Int    @id @default(autoincrement())
  type     String @default("SCANNER") // SCANNER | RADIO
  number   String // printed label, e.g. "12"
  sortKey  Int    // numeric value of `number` for stable ordering
  status   String @default("AVAILABLE") // AVAILABLE | CHECKED_OUT | RETURNED | DAMAGED | OUT_OF_SERVICE
  scanCode String? @unique // reserved for future QR/barcode support (asset tag)
  damageNote String? // set when a tech flags a device damaged; cleared on review
  damagePhoto String? // optional data-URL photo captured when flagging damage; cleared with the note

  // current-cycle fields (cleared when the device returns to AVAILABLE)
  checkedOutById Int?
  checkedOutBy   Worker? @relation("DeviceCheckedOutBy", fields: [checkedOutById], references: [id])
  checkedOutAt   DateTime?
  dueAt          DateTime?

  retiredAt DateTime?

  events    DeviceEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, number])
  @@index([type, sortKey])
}

// A person who acts on devices. Identified by a short PIN (and optional badge).
model Worker {
  id       Int     @id @default(autoincrement())
  name     String
  pin      String  @unique // short numeric PIN entered on the tablet (stored hashed)
  badgeId  String? @unique
  roles    String  @default("OPERATOR") // comma-separated: OPERATOR,TECH,LEAD,SUPERVISOR,ADMIN
  active   Boolean @default(true)

  events         DeviceEvent[]
  devicesOut     Device[]      @relation("DeviceCheckedOutBy")
  createdAt      DateTime      @default(now())
}

// Immutable audit record — one row per state transition. Never edited or deleted.
model DeviceEvent {
  id         Int      @id @default(autoincrement())
  deviceId   Int
  device     Device   @relation(fields: [deviceId], references: [id])
  workerId   Int?
  worker     Worker?  @relation(fields: [workerId], references: [id])
  action     String   // CHECKOUT | RETURN | INSPECT | DAMAGE | REVIEW_RETURN | RETIRE | RESTORE | ADD | RETYPE | EDIT
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([deviceId])
  @@index([createdAt])
}

// Simple key/value configuration store.
model Setting {
  key   String @id
  value String
}
