# Copy to .env and adjust for your environment.

# PostgreSQL connection string.
# Local dev: use a throwaway Postgres (see README), or your own.
# On Railway/Render: the database provides this automatically.
DATABASE_URL="postgresql://device:device@localhost:5432/devicedb?schema=public"

# Timezone used to DISPLAY server time in Admin → Advanced → System and in
# Teams messages. Due times are "N hours after checkout" (set per device type
# in Admin → Advanced → Checkout policy), so they do not depend on this —
# but set it to the warehouse's zone (e.g. America/Chicago, America/New_York)
# so logged times read correctly. On most cloud hosts the default is UTC.
TZ="America/New_York"
